                                    <dt>
                                        <em>Attribute Label: </em>BAXTER
                                    </dt>
                                    <dt>
                                        <em>Attribute Definition: </em>identifies areas within the jurisdiction of Baxter State Park Authority (BSPA)
                                    </dt>
                                    <dt>
                                        <em>Attribute Definition Source: </em>BSPA
                                    </dt>
