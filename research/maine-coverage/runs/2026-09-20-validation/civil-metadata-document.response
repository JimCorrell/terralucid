                            </dt>
                            <dd>
                                <dl>
                                    <dt>
                                        <em>Entity Type Label: </em>Maine_Boundaries_Town_Polygon
                                    </dt>
                                    <dt>
                                        <em>Entity Type Definition: </em>polygon feature class
                                    </dt>
                                    <dt>
