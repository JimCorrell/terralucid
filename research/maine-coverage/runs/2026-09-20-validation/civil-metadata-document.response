                                                    <dt>
                                                        <em>Enumerated Domain Value: </em>y
                                                    </dt>
                                                    <dt>
                                                        <em>Enumerated Domain Value Definition: </em>ISLANDID also represents a Coastal Island Registry number
                                                    </dt>
                                                </dl>
                                            </dd>
                                        </dl>
                                    </dd>
                                </dl>
